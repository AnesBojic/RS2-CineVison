# Build email worker (separate container from the API)
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY eCommerce.Worker/eCommerce.Worker.csproj eCommerce.Worker/
COPY eCommerce.Model/eCommerce.Model.csproj eCommerce.Model/

RUN dotnet restore eCommerce.Worker/eCommerce.Worker.csproj

COPY eCommerce.Worker/ eCommerce.Worker/
COPY eCommerce.Model/ eCommerce.Model/

RUN dotnet publish eCommerce.Worker/eCommerce.Worker.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS final
WORKDIR /app

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "eCommerce.Worker.dll"]
