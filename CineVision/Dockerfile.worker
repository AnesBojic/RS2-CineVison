# Build email worker (separate container from the API)
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY CineVision.Worker/CineVision.Worker.csproj CineVision.Worker/
COPY CineVision.Model/CineVision.Model.csproj CineVision.Model/

RUN dotnet restore CineVision.Worker/CineVision.Worker.csproj

COPY CineVision.Worker/ CineVision.Worker/
COPY CineVision.Model/ CineVision.Model/

RUN dotnet publish CineVision.Worker/CineVision.Worker.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS final
WORKDIR /app

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "CineVision.Worker.dll"]
