# ============================================================================
# CineVision — lokalna konfiguracija (NE COMMITATI)
# ============================================================================
# Jedini izvor tajni. Docker Compose i lokalni "dotnet run" citaju ovaj fajl.
# Kad bude vrijeme za rotaciju, zamijeni vrijednosti ovdje — ne u appsettings.json.
#
# Kopiraj: Copy-Item .env.example .env  pa popuni prazna polja.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. INFRASTRUKTURA (docker-compose ${VAR})
# ----------------------------------------------------------------------------
MSSQL_SA_PASSWORD=
DB_NAME=200017
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SQL_HOST_PORT=1435
API_HOST_PORT=5126


# ----------------------------------------------------------------------------
# 2. KONEKCIJSKI STRING — lokalni "dotnet run" (SQL u Dockeru na portu 1435)
# ----------------------------------------------------------------------------
# Docker Compose za API kontejner nadjacava host sa cinevision-sql (vidi docker-compose.yml).
ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=200017;User Id=;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True


# ----------------------------------------------------------------------------
# 3. JWT
# ----------------------------------------------------------------------------
JwtToken__SecretKey=
JwtToken__Issuer=https://CineVision.com
JwtToken__Audience=http://CineVision.com
JwtToken__DurationInMinutes=30


# ----------------------------------------------------------------------------
# 4. RABBITMQ — lokalni host; Compose nadjacava Host na cinevision-rabbitmq
# ----------------------------------------------------------------------------
RabbitMq__Enabled=true
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
RabbitMq__Queue=cinevision-emails


# ----------------------------------------------------------------------------
# 5. SMTP
# ----------------------------------------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=CineVision
Smtp__UseSsl=false


# ----------------------------------------------------------------------------
# 6. STRIPE
# ----------------------------------------------------------------------------
Stripe__PublishableKey=
Stripe__SecretKey=


# ----------------------------------------------------------------------------
# 7. OPENAI
# ----------------------------------------------------------------------------
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini
OpenAI__MaxTokens=800


# ----------------------------------------------------------------------------
# 8. RECOMMENDER
# ----------------------------------------------------------------------------
Recommendations__PopularityWeight=0.4
Recommendations__ContentWeight=0.4
Recommendations__SearchWeight=0.2


# ----------------------------------------------------------------------------
# 9. FLUTTER API adrese (dokumentacija; predaju se preko --dart-define)
# ----------------------------------------------------------------------------
API_BASE_URL_DESKTOP=http://localhost:5126/
API_BASE_URL_MOBILE=http://10.0.2.2:5126/
