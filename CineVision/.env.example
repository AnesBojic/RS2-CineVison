# ============================================================================
# CineVision â€” template konfiguracije
# ============================================================================
# Kopiraj u ".env" pored docker-compose.yml i zamijeni sve CHANGE_ME vrijednosti:
#
#   Copy-Item .env.example .env
#
# ".env" je u .gitignore i nikada se ne commituje.
# Ovaj ".env.example" se commituje i sadrzi samo placeholdere.
#
# Docker Compose i lokalni "dotnet run" citaju .env. Compose nadjacava
# ConnectionStrings host i RabbitMq__Host na nazive docker servisa.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. INFRASTRUKTURA â€” cita docker-compose.yml kroz ${VAR} zamjenu
# ----------------------------------------------------------------------------
MSSQL_SA_PASSWORD=CHANGE_ME_sa_password
DB_NAME=CHANGE_ME_broj_indeksa
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SQL_HOST_PORT=1435
API_HOST_PORT=5126


# ----------------------------------------------------------------------------
# 2. KONEKCIJSKI STRING â€” lokalni "dotnet run" (SQL u Dockeru na SQL_HOST_PORT)
# ----------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=CHANGE_ME_broj_indeksa;User Id=sa;Password=CHANGE_ME_sa_password;TrustServerCertificate=True;MultipleActiveResultSets=True


# ----------------------------------------------------------------------------
# 3. JWT
# ----------------------------------------------------------------------------
# Kljuc mora biti dovoljno dug za HMAC-SHA256 (minimalno 32 znaka).
# Ako kljuc sadrzi znak $, escapaj ga kao $$ (Docker Compose + EnvFileLoader).
JwtToken__SecretKey=CHANGE_ME_jwt_secret_minimalno_32_znaka
JwtToken__Issuer=https://CineVision.com
JwtToken__Audience=http://CineVision.com
JwtToken__DurationInMinutes=30


# ----------------------------------------------------------------------------
# 4. RABBITMQ
# ----------------------------------------------------------------------------
RabbitMq__Enabled=true
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
RabbitMq__Queue=cinevision-emails


# ----------------------------------------------------------------------------
# 5. SMTP
# ----------------------------------------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__User=CHANGE_ME@gmail.com
Smtp__Password=CHANGE_ME_gmail_app_password
Smtp__FromEmail=CHANGE_ME@gmail.com
Smtp__FromName=CineVision
Smtp__UseSsl=false


# ----------------------------------------------------------------------------
# 6. STRIPE (sandbox)
# ----------------------------------------------------------------------------
Stripe__PublishableKey=CHANGE_ME_pk_test
Stripe__SecretKey=CHANGE_ME_sk_test


# ----------------------------------------------------------------------------
# 7. OPENAI
# ----------------------------------------------------------------------------
OpenAI__ApiKey=CHANGE_ME_sk_proj
OpenAI__Model=gpt-4o-mini
OpenAI__MaxTokens=800


# ----------------------------------------------------------------------------
# 8. RECOMMENDER
# ----------------------------------------------------------------------------
Recommendations__PopularityWeight=0.4
Recommendations__ContentWeight=0.4
Recommendations__SearchWeight=0.2


# ----------------------------------------------------------------------------
# 9. FLUTTER API adrese (predaju se preko --dart-define)
# ----------------------------------------------------------------------------
#   flutter run -d windows --dart-define=API_BASE_URL=http://localhost:5126/
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5126/
API_BASE_URL_DESKTOP=http://localhost:5126/
API_BASE_URL_MOBILE=http://10.0.2.2:5126/
